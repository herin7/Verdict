{
  "name": "@verdict/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verdict decision-engine API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx src/marketplaces/registry.test.ts && tsx src/marketplaces/normalize.test.ts && tsx test/ai-gateway.test.ts && tsx test/consensus-report-schema.test.ts && tsx test/http-reliability.test.ts && tsx test/content-hash.test.ts && tsx test/app.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1088.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-textract": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.3",
    "openai": "^6.48.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-node": "^5.43.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
