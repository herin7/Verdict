{
  "name": "@verdict/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "run:android": "expo run:android",
    "eas:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "update:preview": "eas update --channel preview --platform android --auto",
    "update:prod": "eas update --channel production --platform android --auto",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "aes-js": "^3.1.2",
    "expo": "^58.0.20",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "^9.0.0",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.7",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.84.2",
    "react": "19.2.3",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~2.0.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.3",
    "babel-preset-expo": "~58.0.21",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
