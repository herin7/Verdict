{
  "expo": {
    "name": "Verdict",
    "slug": "anakin-consensus",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "verdict",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.herin.verdict"
    },
    "android": {
      "package": "com.herin.verdict",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1F3BD6"
      },
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F3BD6",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#080B16"
          }
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F3BD6"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.verdict.app.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.herin.verdict"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "fcae8544-9bd7-490b-9410-f5c12dbafb2b"
      },
      "router": {}
    },
    "updates": {
      "url": "https://u.expo.dev/fcae8544-9bd7-490b-9410-f5c12dbafb2b"
    }
  }
}
